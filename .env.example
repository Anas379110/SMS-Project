# .env.example — انسخ إلى .env واملأ القيم الفعلية محلياً. لا تضف قيماً حقيقية هنا أبداً.

# Database (Supabase — خاص بنسخة هذه المدرسة فقط)
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# School / Tenant Config (خاص بهذه النسخة تحديداً — راجع tenant-provisioning Skill)
SCHOOL_COUNTRY=          # مثال: SA, AE, IQ, SY, GB, US — يحدد مسار الدفع
SCHOOL_DEFAULT_LOCALE=ar # ar | en

# Payment — يُملأ حسب SCHOOL_COUNTRY (راجع DECISIONS.md لجدول الدول↔البوابة)
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
