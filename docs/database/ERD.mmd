        string fullName
        date birthDate
        string status
    }
    ClassRoom {
        string id PK
        string name
        string academicYear
    }
    Enrollment {
        string id PK
        string studentId FK
        string classRoomId FK
    }
    Subject {
        string id PK
        string name
    }
    TeacherAssignment {
        string id PK
        string teacherUserId FK
        string classRoomId FK
        string subjectId FK
    }
    AttendanceRecord {
        string id PK
        string studentId FK
        string classRoomId FK
        date date
        string status
    }
    Grade {
        string id PK
        string studentId FK
        string subjectId FK
        float score
        string term
    }
    ScheduleEntry {
        string id PK
        string classRoomId FK
        string subjectId FK
        string dayOfWeek
