erDiagram
    User ||--|| Role : has
    Guardian ||--o{ Student : "parent of"
    Student ||--o{ Enrollment : has
    ClassRoom ||--o{ Enrollment : contains
    ClassRoom ||--o{ TeacherAssignment : "taught in"
    User ||--o{ TeacherAssignment : "teacher (User)"
    Subject ||--o{ TeacherAssignment : "subject taught"
    Student ||--o{ AttendanceRecord : has
    ClassRoom ||--o{ AttendanceRecord : "recorded in"
    Student ||--o{ Grade : has
    Subject ||--o{ Grade : "grade for"
    ClassRoom ||--o{ ScheduleEntry : has
    Subject ||--o{ ScheduleEntry : "scheduled subject"
    Student ||--o{ Invoice : receives
    Invoice ||--o{ Payment : "paid via"
    FeeStructure ||--o{ Invoice : "based on"
    User ||--o{ Notification : receives

    User {
        string id PK
        string email UK
        string passwordHash
        string roleId FK
        datetime createdAt
    }
    Guardian {
        string id PK
        string userId FK
        string fullName
        string phone
    }
    Student {
        string id PK
